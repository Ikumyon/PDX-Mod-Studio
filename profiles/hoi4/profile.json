{
    "id": "hoi4",
    "name": "Hearts of Iron IV",
    "version": "1.14.*",
    "format_version": "1",
    "icon": "DLC_HoI4.png",
    "document_types": [
        {
            "id": "event_file",
            "path_globs": [
                "events/*.txt",
                "events/**/*.txt"
            ],
            "extensions": [
                ".txt"
            ]
        },
        {
            "id": "decision_file",
            "path_globs": [
                "common/decisions/*.txt",
                "common/decisions/**/*.txt"
            ],
            "extensions": [
                ".txt"
            ]
        }
    ],
    "entity_rules": [
        {
            "document_type": "event_file",
            "key": "country_event",
            "kind": "event",
            "subtype": "country_event",
            "schema": "event",
            "id": {
                "from": "property",
                "property": "id"
            },
            "children": [
                {
                    "key": "option",
                    "kind": "event_option",
                    "subtype": "option",
                    "schema": "event_option",
                    "id": {
                        "from": "property",
                        "property": "name"
                    }
                }
            ]
        },
        {
            "document_type": "event_file",
            "key": "news_event",
            "kind": "event",
            "subtype": "news_event",
            "schema": "event",
            "id": {
                "from": "property",
                "property": "id"
            },
            "children": [
                {
                    "key": "option",
                    "kind": "event_option",
                    "subtype": "option",
                    "schema": "event_option",
                    "id": {
                        "from": "property",
                        "property": "name"
                    }
                }
            ]
        }
    ],
    "schemas": {
        "event": {
            "properties": {
                "id": {
                    "type": "event_id",
                    "display_name": "ID",
                    "required": true
                },
                "title": {
                    "type": "localisation_key",
                    "display_name": "Title",
                    "reference_kind": "localisation"
                },
                "desc": {
                    "type": "localisation_key",
                    "display_name": "Description",
                    "reference_kind": "localisation"
                },
                "picture": {
                    "type": "gfx",
                    "display_name": "Picture",
                    "reference_kind": "asset"
                },
                "fire_only_once": {
                    "type": "bool",
                    "display_name": "Fire only once"
                },
                "is_triggered_only": {
                    "type": "bool",
                    "display_name": "Triggered only"
                },
                "major": {
                    "type": "bool",
                    "display_name": "Major"
                },
                "hidden": {
                    "type": "bool",
                    "display_name": "Hidden"
                },
                "trigger": {
                    "type": "object",
                    "display_name": "Trigger"
                },
                "mean_time_to_happen": {
                    "type": "object",
                    "display_name": "Mean time to happen"
                },
                "option": {
                    "type": "object",
                    "display_name": "Option",
                    "multiple": true
                }
            }
        },
        "event_option": {
            "properties": {
                "name": {
                    "type": "localisation_key",
                    "display_name": "Name",
                    "required": true,
                    "reference_kind": "localisation"
                },
                "trigger": {
                    "type": "object",
                    "display_name": "Trigger"
                },
                "ai_chance": {
                    "type": "object",
                    "display_name": "AI chance"
                }
            }
        }
    },
    "references": [
        {
            "source_kind": "event",
            "property": "title",
            "target_kind": "localisation",
            "state_if_missing": "external_possible"
        },
        {
            "source_kind": "event",
            "property": "desc",
            "target_kind": "localisation",
            "state_if_missing": "external_possible"
        },
        {
            "source_kind": "event",
            "property": "picture",
            "target_kind": "asset",
            "state_if_missing": "external_possible"
        },
        {
            "source_kind": "event_option",
            "property": "name",
            "target_kind": "localisation",
            "state_if_missing": "external_possible"
        }
    ],
    "relations": [
        {
            "source_kind": "event",
            "property": "picture",
            "target_kind": "asset",
            "type": "uses_asset",
            "label": "uses asset"
        }
    ]
}
