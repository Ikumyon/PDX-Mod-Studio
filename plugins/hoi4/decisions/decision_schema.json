{
  "schema_name": "hoi4_decision",
  "file_scope": "common/decisions",
  "root_pattern": "nested_named_block",
  "id_rule": {
    "source": "key",
    "type": "identifier",
    "role": "decision_id",
    "parent": {
      "source": "outer_key",
      "type": "identifier",
      "role": "decision_category_id"
    }
  },
  "unknown_keys": "warn",
  "fields": {
    "icon": {
      "type": "sprite_id",
      "required": false,
      "multiple": false,
      "reference": "interface_gfx_sprite"
    },
    "cost": {
      "type": [
        "integer",
        "scripted_value_block"
      ],
      "required": false,
      "multiple": false
    },
    "fire_only_once": {
      "type": "boolean",
      "required": false,
      "multiple": false,
      "allowed_values": [
        "yes",
        "no"
      ]
    },
    "days_remove": {
      "type": "integer",
      "required": false,
      "multiple": false
    },
    "days_re_enable": {
      "type": "integer",
      "required": false,
      "multiple": false
    },
    "allowed": {
      "type": "trigger_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "available": {
      "type": "trigger_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "visible": {
      "type": "trigger_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "modifier": {
      "type": "modifier_block",
      "required": false,
      "multiple": false
    },
    "complete_effect": {
      "type": "effect_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "remove_effect": {
      "type": "effect_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "timeout_effect": {
      "type": "effect_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "ai_will_do": {
      "type": "ai_chance_block",
      "required": false,
      "multiple": false
    },
    "custom_cost_trigger": {
      "type": "trigger_block",
      "required": false,
      "multiple": false,
      "context": "country"
    },
    "custom_cost_text": {
      "type": "localisation_key",
      "required": false,
      "multiple": false
    }
  }
}
