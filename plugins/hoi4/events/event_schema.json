{
  "schema_name": "hoi4_event",
  "file_scope": "events",
  "root_pattern": "named_block",
  "id_rule": {
    "source": "inner_property",
    "property_name": "id",
    "type": "identifier",
    "role": "event_id"
  },
  "unknown_keys": "warn",
  "document_properties": {
    "add_namespace": {
      "ui_widget": "namespaceEdit"
    }
  },
  "fields": {
    "id": {
        "type": "identifier",
        "required": true
    },
    "title": {
        "type": "localisation_key",
        "required": true
    },
    "desc": { 
        "type": "localisation_key"
    },
    "picture": { 
        "type": "sprite_id"
    },
    "is_triggered_only": { 
        "type": "boolean",
        "allowed_values": ["yes", "no"] 
    },
    "fire_only_once": {
         "type": "boolean",
        "allowed_values": ["yes", "no"] 
    },
    "trigger": {
        "type": "trigger_block",
        "context": "country"
    },
    "mean_time_to_happen": {
        "type": "mtth_block"
    },
    "immediate": {
        "type": "effect_block",
        "context": "country"
    },
    "option": {
        "type": "object",
        "multiple": true,
        "schema": "event_option"
    }
  },
  "sub_schemas": {
    "event_option": {
      "fields": {
        "name": {
          "type": "localisation_key",
          "required": true
        },
        "trigger": {
          "type": "trigger_block",
          "required": false
        },
        "ai_chance": {
          "type": "ai_chance_block",
          "required": false
        },
        "tooltip": {
          "type": "localisation_key",
          "required": false
        }
      }
    }
  }
}
